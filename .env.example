# 复制成 .env 后按实际环境修改；.env 不要提交到仓库
APP_NAME=B2C 商城后端服务
DEBUG=false

# MySQL 连接信息
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=改成你的数据库密码
MYSQL_DATABASE=ebusiness_mall
# 也可以整串覆盖：DATABASE_URL=mysql+pymysql://user:pwd@127.0.0.1:3306/ebusiness_mall?charset=utf8mb4

# JWT：部署到公网前务必换成随机长字符串
JWT_SECRET=please-change-this-secret-in-production
JWT_EXPIRE_MINUTES=120

# 跨域白名单，多个用逗号分隔；开发期可留 *
CORS_ORIGINS=*

# 首次启动自动建表并播种演示数据（生产建议 false，改用 sql/*.sql 或 python -m scripts.init_db）
AUTO_INIT_DB=false
